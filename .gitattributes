# Explicitly force GitHub to recognize our actual backend/frontend languages
*.cs linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# Force hide all HTML files globally from language statistics
*.html linguist-detectable=false
*.htm linguist-detectable=false

# Mark any deeply nested build/test artifacts as generated (Linguist ignores these)
**/playwright-report/** linguist-generated=true
**/test-results/** linguist-generated=true
**/out/** linguist-generated=true
**/.next/** linguist-generated=true
**/wwwroot/** linguist-generated=true
**/bin/** linguist-generated=true
**/obj/** linguist-generated=true
